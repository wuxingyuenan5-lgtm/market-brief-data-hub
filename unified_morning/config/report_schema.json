{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unified Morning Brief Payload",
  "type": "object",
  "required": ["report_meta", "summary", "asset_overview", "overnight_drivers", "china_market", "mainlines", "today_validation", "events", "sources"],
  "properties": {
    "report_meta": {
      "type": "object",
      "required": ["report_name", "report_date", "report_cutoff", "timezone", "china_market_date", "global_market_date"],
      "properties": {
        "report_name": {"const": "统一交易晨报"},
        "report_date": {"type": "string", "format": "date"},
        "report_cutoff": {"type": "string"},
        "timezone": {"const": "Asia/Shanghai"},
        "china_market_date": {"type": "string", "format": "date"},
        "global_market_date": {"type": "string", "format": "date"},
        "a_share_analysis_status": {"enum": ["full", "core_only"]}
      }
    },
    "summary": {"type": "object"},
    "asset_overview": {"type": "array", "items": {"$ref": "#/$defs/marketFact"}},
    "overnight_drivers": {"type": "array"},
    "china_market": {"type": "object"},
    "mainlines": {"type": "array", "minItems": 3, "maxItems": 3},
    "today_validation": {"type": "array"},
    "previous_review": {"type": "array"},
    "research_updates": {"type": "array", "maxItems": 4},
    "funding_industry": {"type": "array"},
    "tracking": {"type": "array", "minItems": 0, "maxItems": 6},
    "events": {"type": "array"},
    "sources": {"type": "array"}
  },
  "$defs": {
    "marketFact": {
      "type": "object",
      "required": ["asset", "value", "market_timestamp", "trading_date", "source_id", "source_url", "exact_instrument", "unit", "methodology"],
      "properties": {
        "market": {"type": "string"},
        "asset": {"type": "string"},
        "value": {},
        "change": {},
        "market_timestamp": {"type": "string"},
        "release_timestamp": {"type": "string"},
        "fetched_at": {"type": "string"},
        "trading_date": {"type": "string"},
        "source_id": {"type": "string"},
        "source_url": {"type": "string"},
        "exact_instrument": {"type": "string"},
        "unit": {"type": "string"},
        "currency": {"type": ["string", "null"]},
        "methodology": {"type": "string"},
        "meaning": {"type": "string"}
      }
    }
  }
}