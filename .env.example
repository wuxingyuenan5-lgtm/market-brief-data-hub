# Do not put real values in this public repository.

# Required only when SEC EDGAR code is actually executed.
SEC_CONTACT_NAME=Your Name
SEC_CONTACT_EMAIL=your-email@example.com

# Optional authenticated GitHub API access for higher rate limits.
GITHUB_TOKEN=

# Optional proxy variables for local execution.
HTTP_PROXY=
HTTPS_PROXY=

# Cache and output directories.
MARKET_BRIEF_CACHE_DIR=.cache
MARKET_BRIEF_OUTPUT_DIR=reports

# Default timezone.
TZ=Asia/Shanghai
